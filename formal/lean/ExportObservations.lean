import Observations
set_option maxRecDepth 4096
set_option maxHeartbeats 2000000
open Observations
namespace ObservationExport
def alphabet : List (String × Event) :=
  [("timeout", .report true false), ("delivery", .report true true),
   ("invalidTimeout", .report false false), ("invalidDelivery", .report false true),
   ("restart", .restart)]
theorem alphabet_complete (e : Event) : alphabet.any (fun p => decide (p.2 = e)) = true := by
  cases e with
  | report verified delivered => cases verified <;> cases delivered <;> decide
  | restart => decide

def source (context : Nat) : Hawala.State :=
  let admitted := Hawala.step 900 (Hawala.initial 1000) (.admit true)
  match context with
  | 0 => Hawala.initial 1000
  | 2 => Hawala.step 900 admitted (.claim true)
  | 3 => Hawala.step 900 admitted .expire
  | 4 => Hawala.step 900 admitted .fence
  | _ => admitted

def expand (g : List (Snapshot × List String)) :=
  g.foldl (fun acc p => alphabet.foldl (fun acc e =>
    let next := step 900 p.1 e.2
    if acc.any (fun q => decide (q.1 = next)) then acc
    else acc ++ [(next, p.2 ++ [e.1])]) acc) g

def contexts := [0,1,2,3,4]
def graph (c : Nat) := expand (expand [(initial (source c), [])])
example : contexts.map (fun c => (graph c).length) = [1,5,5,5,5] := by decide
example : contexts.all (fun c => (graph c).all (fun p => alphabet.all (fun e =>
    (graph c).any (fun q => decide (q.1 = step 900 p.1 e.2))))) = true := by decide

def primary (s : Snapshot) : Int := match s.primary with
  | none => -1 | some false => 0 | some true => 1
def bit (b : Bool) := if b then "1" else "0"
def actionName (s : String) := match s with
  | "timeout" => "report(true, 0)" | "delivery" => "report(true, 1)"
  | "invalidTimeout" => "report(false, 0)" | "invalidDelivery" => "report(false, 1)"
  | _ => "restart"
end ObservationExport
open ObservationExport

def main (args : List String) : IO Unit := do
  let out ← IO.getStdout
  let quint := args == ["quint"]
  if quint then out.putStrLn "// Generated by Lean; do not edit.\nmodule observationConformance {\n  import observations.* from \"./observations\""
  else out.putStrLn "# context path primary conflict uncertain"
  let mut index := 0
  for c in contexts do
    for p in graph c do
      for e in alphabet do
        let path := p.2 ++ [e.1]
        let target := step 900 p.1 e.2
        if quint then
          let acts := String.join (path.map (fun name => s!".then({actionName name})"))
          out.putStrLn s!"  run reportEdge{index}Test = initWith({c}){acts}.expect(seen == {primary target} and conflict == {target.conflict} and uncertain == {target.intent.uncertain})"
        else
          out.putStrLn s!"{c}\t{String.intercalate "," path}\t{primary target}\t{bit target.conflict}\t{bit target.intent.uncertain}"
        index := index + 1
  if quint then out.putStrLn "}"
