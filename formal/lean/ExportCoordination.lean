import Coordination
set_option maxRecDepth 4096
set_option maxHeartbeats 4000000
open Coordination
namespace CoordinationExport
def alphabet : List (String × Event) :=
  [("left", .reserveLeft), ("right", .reserveRight), ("commit", .commit),
   ("abort", .abort), ("releaseLeft", .releaseLeft), ("releaseRight", .releaseRight),
   ("timeout", .timeout), ("restart", .restart), ("denied", .denied)]
theorem alphabet_complete (e : Event) : alphabet.any (fun p => decide (p.2 = e)) = true := by
  cases e <;> decide
def expand (g : List (State × List String)) :=
  g.foldl (fun acc p => alphabet.foldl (fun acc e =>
    let next := step p.1 e.2
    if acc.any (fun q => decide (q.1 = next)) then acc
    else acc ++ [(next, p.2 ++ [e.1])]) acc) g
def graph := expand (expand (expand (expand (expand [(initial, [])]))))
example : graph.length = 14 := by decide
example : graph.all (fun p => alphabet.all (fun e =>
    graph.any (fun q => decide (q.1 = step p.1 e.2)))) = true := by decide
def bit (b : Bool) := if b then "1" else "0"
def fields (s : State) := String.intercalate "\t"
  [toString s.decision, bit s.leftLocked, bit s.rightLocked, bit s.leftReleased, bit s.rightReleased]
def record (s : State) :=
  "{ decision: " ++ toString s.decision ++ ", leftLocked: " ++ toString s.leftLocked ++
  ", rightLocked: " ++ toString s.rightLocked ++ ", leftReleased: " ++ toString s.leftReleased ++
  ", rightReleased: " ++ toString s.rightReleased ++ " }"
def actionName (s : String) := match s with
  | "left" => "reserveLeft" | "right" => "reserveRight"
  | "commit" => "commit" | "abort" => "abort"
  | "releaseLeft" => "releaseLeft" | "releaseRight" => "releaseRight"
  | _ => "stutter"
end CoordinationExport
open CoordinationExport
def main (args : List String) : IO Unit := do
  let out ← IO.getStdout
  let quint := args == ["quint"]
  if quint then out.putStrLn "// Generated by Lean; do not edit.\nmodule coordinationConformance {\n  import coordination.* from \"./coordination\""
  else out.putStrLn "# path decision leftLocked rightLocked leftReleased rightReleased"
  let mut index := 0
  for p in graph do
    for e in alphabet do
      let path := p.2 ++ [e.1]
      let target := step p.1 e.2
      if quint then
        let acts := String.join (path.map (fun name => s!".then({actionName name})"))
        out.putStrLn s!"  run coordinationEdge{index}Test = init{acts}.expect(s == {record target})"
      else out.putStrLn s!"{String.intercalate "," path}\t{fields target}"
      index := index + 1
  if quint then out.putStrLn "}"
