import CoordinatedAdmission
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000
open CoordinatedAdmission
namespace CoordinatedExport
def alphabet : List (String × Event) :=
  [("left", .left), ("right", .right), ("admit", .admit true), ("denied", .admit false),
   ("abort", .abort), ("fence", .fence), ("restart", .restart), ("replay", .replay), ("legacy", .legacy)]
theorem alphabet_complete (e : Event) : alphabet.any (fun p => decide (p.2 = e)) = true := by
  cases e with
  | admit b => cases b <;> decide
  | left | right | abort | fence | restart | replay | legacy => decide
def expand (g : List (State × List String)) :=
  g.foldl (fun acc p => alphabet.foldl (fun acc e =>
    let next := step 900 p.1 e.2
    if acc.any (fun q => decide (q.1 = next)) then acc
    else acc ++ [(next, p.2 ++ [e.1])]) acc) g
def graph := expand (expand (expand (expand [(initial 1000, [])])))
example : graph.length = 18 := by decide
example : graph.all (fun p => alphabet.all (fun e =>
    graph.any (fun q => decide (q.1 = step 900 p.1 e.2)))) = true := by decide
def bit (b : Bool) := if b then "1" else "0"
def fields (s : State) := String.intercalate "\t"
  [toString s.custody.decision, bit s.custody.leftLocked, bit s.custody.rightLocked,
   toString s.financial.available, toString s.financial.reserved,
   bit s.financial.committed, bit s.financial.nonce, bit s.financial.epochCurrent]
def record (s : State) :=
  "{ decision: " ++ toString s.custody.decision ++ ", leftLocked: " ++ toString s.custody.leftLocked ++
  ", rightLocked: " ++ toString s.custody.rightLocked ++ ", available: " ++ toString s.financial.available ++
  ", reserved: " ++ toString s.financial.reserved ++ ", committed: " ++ toString s.financial.committed ++
  ", nonce: " ++ toString s.financial.nonce ++ ", current: " ++ toString s.financial.epochCurrent ++ " }"
def actionName (s : String) := match s with
  | "left" => "left" | "right" => "right" | "admit" => "admit(true)"
  | "denied" => "admit(false)" | "abort" => "abort" | "fence" => "fence" | _ => "stutter"
end CoordinatedExport
open CoordinatedExport
def main (args : List String) : IO Unit := do
  let out ← IO.getStdout
  let quint := args == ["quint"]
  if quint then out.putStrLn "// Generated by Lean; do not edit.\nmodule coordinatedConformance {\n  import coordinatedAdmission.* from \"./coordinatedAdmission\""
  else out.putStrLn "# path decision left right available reserved committed nonce current"
  let mut index := 0
  for p in graph do
    for e in alphabet do
      let path := p.2 ++ [e.1]
      let target := step 900 p.1 e.2
      if quint then
        let acts := String.join (path.map (fun name => s!".then({actionName name})"))
        out.putStrLn s!"  run coordinatedEdge{index}Test = init{acts}.expect(s == {record target})"
      else out.putStrLn s!"{String.intercalate "," path}\t{fields target}"
      index := index + 1
  if quint then out.putStrLn "}"
