import CrossAuthority
open CrossAuthority
namespace CrossAuthorityExport
abbrev NamedEvent := String × Event

def send : NamedEvent := ("sendPrepare", .sendPrepare)
def pl : NamedEvent := ("prepareL(0,0,0)", .prepareL 0 0 0)
def pr : NamedEvent := ("prepareR(0,0,0)", .prepareR 0 0 0)
def rl : NamedEvent := ("receiveL", .receiveL)
def rr : NamedEvent := ("receiveR", .receiveR)
def commit : NamedEvent := ("commit", .commit)
def abort : NamedEvent := ("abort", .abort)
def pub : NamedEvent := ("publish", .publish)
def dl : NamedEvent := ("deliverL", .deliverL 0 0)
def dr : NamedEvent := ("deliverR", .deliverR 0 0)
def fc : NamedEvent := ("fenceCoordinator", .fenceCoordinator)
def fl : NamedEvent := ("fenceLeft", .fenceLeft)
def fr : NamedEvent := ("fenceRight", .fenceRight)
def log : NamedEvent := ("recoverLog", .recoverLog)
def pubrec : NamedEvent := ("publishRecovery", .publishRecovery)
def il : NamedEvent := ("installL", .installL)
def ir : NamedEvent := ("installR", .installR)
def al : NamedEvent := ("activateL", .activateL)
def ar : NamedEvent := ("activateR", .activateR)
def rec : NamedEvent := ("recover", .recover)
def ready := [send, pl, pr, rl, rr]
def decided := ready ++ [commit, pub]
def scenarios : List (String × List NamedEvent) := [
  ("commit_duplicate_delivery", decided ++ [dl, dl, dr, dr, abort]),
  ("abort_before_late_prepare", [send, abort, pub, dl, pr, rr, commit, dr]),
  ("refusal_fences_late_prepare", [send, ("refuseL", .refuseL), pl, pr, rl, rr, commit, abort, pub, dl, dr]),
  ("prepared_timeout_partition", [send, pl, ("partitionL", .partitionL), ("timeout", .timeout),
    ("refuseL", .refuseL), ("crashC", .crashC), ("restartC", .restartC), ("healL", .healL),
    pr, rl, rr, commit, pub, dl, dr]),
  ("crash_after_decision_before_publish", ready ++ [commit, ("crashC", .crashC), pub,
    ("restartC", .restartC), pub, dr, dl]),
  ("independent_participant_restart", decided ++ [("crashL", .crashL), dl, dr,
    ("restartL", .restartL), dl, ("crashR", .crashR), ("restartR", .restartR), dr]),
  ("recovery_keeps_commit", decided ++ [dl, fc, fl, fr, log, pubrec, il, ir, rec, al, ar, abort, dr]),
  ("recovery_keeps_abort", [send, pl, abort, pub, dr, fc, fl, fr, log, pubrec, il, ir, rec, al, ar, commit, dl]),
  ("recovery_without_history_holds", [send, pl, fc, fl, fr, pubrec, il, ir, rec, al, ar, ("restartC", .restartC), commit,
    log, pubrec, il, ir, rec, al, ar, send, ("prepareL(0,0,1)", .prepareL 0 0 1), ("prepareR(0,0,1)", .prepareR 0 0 1), rl, rr, commit, pub, dl, dr]),
  ("partition_blocks_fence", [send, pl, fc, ("partitionR", .partitionR), fl, fr, log, pubrec, il, ir, rec, al, ar,
    ("healR", .healR), fr, pubrec, il, ir, rec, al, ar, send, ("prepareR(0,0,1)", .prepareR 0 0 1), rl, rr, commit, pub, dl, dr]),
  ("replay_wrong_attempt_and_epoch", decided ++ [("foreignAttempt", .deliverL 1 0),
    ("foreignAuthority", .deliverL 0 1), ("prepareL(1,0,0)", .prepareL 1 0 0),
    ("prepareR(0,1,0)", .prepareR 0 1 0), dl, dr]),
  ("partial_epoch_installation", ready ++ [fc, fl, fr, log, pubrec, il,
    ("partitionR", .partitionR), ir, rec, ("crashL", .crashL), ("restartL", .restartL),
    ("healR", .healR), ir, rec, al, ar, send,
    ("prepareL(0,0,1)", .prepareL 0 0 1), ("prepareR(0,0,1)", .prepareR 0 0 1), rl, rr, commit, pub, dl, dr]),
  ("old_coordinator_prepare_fenced", [fc, fl, fr, log, pubrec, il, ir, rec, al, ar, send, pl, pr,
    ("prepareL(0,0,1)", .prepareL 0 0 1), ("prepareR(0,0,1)", .prepareR 0 0 1), rl, rr, commit, pub, dl, dr])]

def fields (s : State) : List (String × String) := [
  ("requested", toString s.requested), ("requestEpoch", toString s.requestEpoch),
  ("voteL", toString s.voteL), ("voteR", toString s.voteR),
  ("seenL", toString s.seenL), ("seenR", toString s.seenR),
  ("decision", toString s.decision), ("wire", toString s.wire),
  ("wireEpoch", toString s.wireEpoch), ("localL", toString s.localL), ("localR", toString s.localR),
  ("upC", toString s.upC), ("upL", toString s.upL), ("upR", toString s.upR),
  ("netL", toString s.netL), ("netR", toString s.netR), ("epoch", toString s.epoch),
  ("installedL", toString s.installedL), ("installedR", toString s.installedR),
  ("recoveryWire", toString s.recoveryWire), ("fenceC", toString s.fenceC), ("fenceL", toString s.fenceL), ("fenceR", toString s.fenceR),
  ("recovered", toString s.recovered)]
def record (s : State) (json : Bool) :=
  "{ " ++ String.intercalate ", " ((fields s).map fun (k,v) =>
    (if json then "\"" ++ k ++ "\"" else k) ++ ": " ++ v) ++ " }"
end CrossAuthorityExport
open CrossAuthorityExport
def main (args : List String) : IO Unit := do
  let out ← IO.getStdout
  let quint := args == ["quint"]
  if quint then out.putStrLn "// Generated by Lean; selected prefix witnesses, not exhaustive refinement.\nmodule crossAuthorityConformance {\n  import crossAuthority.* from \"./crossAuthority\""
  else out.putStrLn "["
  let mut index := 0
  let mut records : List String := []
  for (name, events) in scenarios do
    let mut s := initial
    let mut acts := "init"
    for (actionName, e) in events do
      s := step s e
      acts := acts ++ s!".then({actionName})"
      if quint then out.putStrLn s!"  run crossPrefix{index}Test = {acts}.expect(s == {record s false})"
      else records := records ++ ["  {\"scenario\": \"" ++ name ++ "\", \"prefix\": " ++ toString index ++ ", \"action\": \"" ++ actionName ++ "\", \"expected\": " ++ record s true ++ "}"]
      index := index + 1
  if quint then out.putStrLn "}"
  else out.putStrLn (String.intercalate ",\n" records ++ "\n]")
