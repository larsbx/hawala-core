import Hawala
set_option maxRecDepth 4096
set_option maxHeartbeats 2000000
open Hawala
namespace TraceExport
def alphabet : List (String × Event) :=
  [("admit", .admit true), ("denied", .admit false),
   ("claim", .claim true), ("stale", .claim false),
   ("fence", .fence), ("expire", .expire), ("hold", .hold), ("crash", .crash), ("replay", .replay), ("reject", .reject)]
theorem alphabet_complete (e : Event) : alphabet.any (fun p => decide (p.2 = e)) = true := by
  cases e with
  | admit b => cases b <;> decide
  | claim b => cases b <;> decide
  | hold => decide
  | expire => decide
  | fence => decide
  | crash => decide
  | replay => decide
  | reject => decide

def expand (g : List (State × List String)) : List (State × List String) :=
  g.foldl (fun acc p => alphabet.foldl (fun acc e =>
    let next := step 900 p.1 e.2
    if acc.any (fun q => decide (q.1 = next)) then acc
    else acc ++ [(next, p.2 ++ [e.1])]) acc) g

def graph := expand (expand (expand [(initial 1000, [])]))
example : graph.length = 10 := by decide
example : graph.all (fun p => alphabet.all (fun e =>
    graph.any (fun q => decide (q.1 = step 900 p.1 e.2)))) = true := by decide

def bit (b : Bool) := if b then "1" else "0"
def fields (s : State) : String := String.intercalate "\t"
  [toString s.available, toString s.reserved, bit s.committed, bit s.nonce,
   bit s.claimed, bit s.uncertain, toString s.claims, bit s.expired, bit s.epochCurrent, toString s.fencedClaims]
def record (s : State) : String :=
  "{ available: " ++ toString s.available ++ ", reserved: " ++ toString s.reserved ++
  ", committed: " ++ toString s.committed ++ ", nonce: " ++ toString s.nonce ++
  ", claimed: " ++ toString s.claimed ++ ", uncertain: " ++ toString s.uncertain ++
  ", claims: " ++ toString s.claims ++ ", expired: " ++ toString s.expired ++ ", epochCurrent: " ++ toString s.epochCurrent ++ ", fencedClaims: " ++ toString s.fencedClaims ++ " }"
def actionName (s : String) : String :=
  match s with
  | "admit" => "admit(true)" | "denied" => "admit(false)"
  | "claim" => "claim(true)" | "stale" => "claim(false)"
  | "fence" => "fence" | "expire" => "expire" | "hold" => "hold" | _ => "crashReplayReject"
end TraceExport
open TraceExport

def main (args : List String) : IO Unit := do
  let out ← IO.getStdout
  let quint := args == ["quint"]
  if quint then
    out.putStrLn "// Generated by formal/lean/Export.lean; do not edit.\nmodule conformance {\n  import authority.* from \"./authority\""
  else
    out.putStrLn "# Generated by Lean: path available reserved committed nonce claimed uncertain claims expired epochCurrent fencedClaims"
  let mut index := 0
  for p in graph do
    for e in alphabet do
      let path := p.2 ++ [e.1]
      let target := step 900 p.1 e.2
      if quint then
        let acts := String.join (path.map (fun name => s!".then({actionName name})"))
        out.putStrLn s!"  run edge{index}Test = init{acts}.expect(s == {record target})"
      else
        out.putStrLn s!"{String.intercalate "," path}\t{fields target}"
      index := index + 1
  if quint then out.putStrLn "}"
