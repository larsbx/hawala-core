import TestExecution
open TestExecution
namespace TestExecutionExport
def alphabet : List (String × Event) :=
  [("ticket",.ticket true),("invalidTicket",.ticket false),("execute",.execute true),
   ("wrongScope",.execute false),("fence",.fence),("partition",.partition),("restart",.restart)]
theorem alphabet_complete (e : Event) : alphabet.any (fun p => decide (p.2=e))=true := by
  cases e with
  | ticket b | execute b => cases b <;> decide
  | fence | partition | restart => decide
def expand (g : List (State × List String)) :=
  g.foldl (fun acc p => alphabet.foldl (fun acc e =>
    let next := step p.1 e.2
    if acc.any (fun q => decide (q.1=next)) then acc else acc ++ [(next,p.2++[e.1])]) acc) g
def graph := expand (expand [(initial,[])])
example : graph.length=5 := by decide
example : graph.all (fun p => alphabet.all (fun e =>
    graph.any (fun q => decide (q.1=step p.1 e.2))))=true := by decide
def bit (b : Bool) := if b then "1" else "0"
def actionName (s : String) := match s with
  | "ticket"=>"ticket(true)" | "invalidTicket"=>"ticket(false)"
  | "execute"=>"execute(true)" | "wrongScope"=>"execute(false)" | "fence"=>"fence" | _=>"stutter"
end TestExecutionExport
open TestExecutionExport
def main (args : List String) : IO Unit := do
  let out ← IO.getStdout
  let quint := args==["quint"]
  if quint then out.putStrLn "// Generated by Lean; do not edit.\nmodule testExecutionConformance {\n  import testExecution.* from \"./testExecution\""
  else out.putStrLn "# path ticket terminal effects"
  let mut index := 0
  for p in graph do
    for e in alphabet do
      let path := p.2++[e.1]
      let target := step p.1 e.2
      if quint then
        let acts := String.join (path.map (fun name => s!".then({actionName name})"))
        out.putStrLn s!"  run railEdge{index}Test = init{acts}.expect(s.ticket == {target.ticket} and s.terminal == {target.terminal} and s.effects == {target.effects})"
      else out.putStrLn s!"{String.intercalate "," path}\t{bit target.ticket}\t{target.terminal}\t{target.effects}"
      index := index+1
  if quint then out.putStrLn "}"
